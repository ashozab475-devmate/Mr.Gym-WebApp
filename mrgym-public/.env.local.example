# Copy this file to .env.local

# --- Shared database ---
# MUST be the exact same MONGODB_URI + MONGODB_DB as the
# mrgym-owner-dashboard project. This is what "connects" the two
# websites: this site writes new members into this database when
# someone submits /join, and the dashboard site reads members from the
# very same database, so new sign-ups appear there immediately.
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=mrgym

# Note: this site has no staff/owner login of any kind — that lives
# entirely on the separate mrgym-owner-dashboard project, reachable
# only by going directly to its own URL.
