# Copy this file to .env.local

# --- Shared database ---
# Use the exact same PostgreSQL database URL in both apps.
DATABASE_URL=postgresql://postgres:your_password@localhost:5432/mrgym

# Note: this site has no staff/owner login of any kind — that lives
# entirely on the separate mrgym-owner-dashboard project, reachable
# only by going directly to its own URL.
