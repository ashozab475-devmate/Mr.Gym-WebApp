# Copy this file to .env.local

# --- Shared database ---
# Use the exact same PostgreSQL database URL as the mrgym-public project.
DATABASE_URL=postgresql://postgres:your_password@localhost:5432/mrgym

# --- Link to the public website ---
# The deployed URL of the mrgym-public project. Used for the "back to
# MrGym site" link and the logo link on /login and /dashboard.
# Local dev default (the public project's own README has it running on
# port 3000): http://localhost:3000
NEXT_PUBLIC_PUBLIC_SITE_URL=http://localhost:3000

# --- Owner login (Google sign-in) ---
#
# Uses Google Identity Services (the "Sign in with Google" button),
# which runs client-side - no redirect URI needed, only an authorized
# JavaScript origin.
#
# 1. In Google Cloud Console, create an OAuth 2.0 Client ID
#    (APIs & Services > Credentials > Create Credentials > OAuth client ID,
#    Application type: Web application).
# 2. Under "Authorized JavaScript origins", add:
#      http://localhost:3001
#    (add your production domain here too once you deploy, e.g.
#    https://staff.yourgym.com - no path, no trailing slash).
# 3. Copy the generated Client ID below into BOTH variables - the
#    NEXT_PUBLIC_ one is what the browser uses to load the Google
#    button, the plain one is what the server uses to verify tokens.
#    They must be the same value. (This app doesn't use the Client
#    Secret at all with this sign-in method, but Google still requires
#    you to create a Web application OAuth client to get a Client ID.)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# Comma-separated list of Google account emails allowed to sign in as
# a gym owner. Everyone else's Google sign-in attempt is rejected.
OWNER_EMAILS=owner@example.com

# Run `openssl rand -base64 32` to generate this.
NEXTAUTH_SECRET=replace-with-a-random-32-byte-secret

# The base URL NextAuth uses to build callback URLs (this app's own URL,
# not the public site's).
NEXTAUTH_URL=http://localhost:3001

# --- AI-powered dashboard search (optional) ---
#
# Powers the "Ask about your members" box on the dashboard. Get a key
# from https://console.anthropic.com (API Keys page). Leave unset and
# the rest of the dashboard works fine — you'll just see an error if
# you try the AI search box.
ANTHROPIC_API_KEY=sk-ant-your-key-here
