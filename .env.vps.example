PUBLIC_DOMAIN=example.com
DASHBOARD_DOMAIN=staff.example.com

# Use a long, unique alphanumeric password (for example: openssl rand -hex 24).
POSTGRES_DB=mrgym
POSTGRES_USER=mrgym_app
POSTGRES_PASSWORD=replace_with_a_long_alphanumeric_secret

# Create a Google OAuth Web Client ID. Set the same value for both entries.
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
OWNER_EMAILS=owner@example.com
NEXTAUTH_SECRET=replace_with_a_long_random_secret

# Optional; only needed for AI-powered dashboard search.
ANTHROPIC_API_KEY=